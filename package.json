    "framer-motion": "^11.3.19",
    "gsap": "^3.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "three": "^0.166.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "playwright": "1.56.1",
    "three-mesh-bvh": "0.7.8",
    "vite": "^5.4.0"
  }
}
