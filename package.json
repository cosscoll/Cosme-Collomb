{
  "name": "portfolio-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/normalize-dist.mjs",
    "preview": "vite preview",
    "test:geometry": "node --test tests/geometry.test.js tests/transit.test.js tests/navigation.test.js tests/cameraMotion.test.js tests/cameraSafety.test.js tests/junctionChambers.test.js tests/spatial-network.test.mjs",
    "test:browser": "node tests/network-browser.mjs",
